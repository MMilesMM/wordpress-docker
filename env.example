# Copy to .env and fill in. Generate secrets with: openssl rand -hex 24
MARIADB_ROOT_PASSWORD=
MYSQL_USER=wordpress
MYSQL_PASSWORD=
REDIS_PASSWORD=
WEB_PORT=3000

# Reverse proxy on another server: listen on a private IP of this host and
# trust only the proxy's IP(s) for X-Forwarded-* headers.
# BIND_ADDRESS=10.0.0.10
# WP_TRUSTED_PROXIES=10.0.0.5

# Optional
# TZ=Europe/Berlin
# WORDPRESS_IMAGE=mmilesmm/wordpress-apache-php-fix:5.4.0
# MARIADB_VERSION=12.3
# REDIS_VERSION=7.4-alpine
# REDIS_MAXMEMORY=128mb
# WP_AUTO_UPDATE_EXTENSIONS=true   # auto-update all plugins and themes
# DOCKER_MTU=1450        # if the host MTU is below 1500 (check: ip link)
